# CredVidhi Backend Environment Configuration Example
APP_NAME="CredVidhi API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL 16 (Async)
DATABASE_URL=postgresql+asyncpg://credvidhi:credvidhi_dev_password@localhost:5432/credvidhi

# Redis 7
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=credvidhi_minio
MINIO_SECRET_KEY=credvidhi_minio_secret
MINIO_BUCKET_NAME=credvidhi-documents
MINIO_SECURE=false

# Security & Tokens (Change in production!)
JWT_SECRET=credvidhi-super-secret-development-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "https://credvidhi.vercel.app"]

# ==============================================================================
# LLM / AI Provider Configuration (Server-Side Only — NEVER expose to frontend)
# Reference: .agents/references/awesome-free-llm-apis
# Supported Providers: groq | openrouter | gemini | mistral | nvidia | cohere | ovh | custom
# ==============================================================================
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_llm_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0

# --- Provider Reference Keys & Default Models ---
# Groq (Recommended: 30 RPM, 1,000 RPD free):
#   Key: https://console.groq.com/keys
#   Models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
# OpenRouter (17 free models with ':free' suffix):
#   Key: https://openrouter.ai/keys
#   Models: openai/gpt-oss-20b:free, nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free
# Google Gemini (Generous free tier: 15-30 RPM, 1,500 RPD):
#   Key: https://aistudio.google.com/app/apikey
#   Models: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.5-flash
# Mistral AI ($10/mo free credit allowance):
#   Key: https://console.mistral.ai/api-keys
#   Models: mistral-small-2603, mistral-medium-3-5, codestral
# NVIDIA NIM (40 RPM, 10,000 RPD free with Dev membership):
#   Key: https://build.nvidia.com/explore/discover
#   Models: meta/llama-3.3-70b-instruct, nvidia/nemotron-3-super-120b-a12b
# OVHcloud AI Endpoints (EU Hosted, Keyless / Anonymous 2 RPM):
#   Base URL: https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
#   Models: Meta-Llama-3_3-70B-Instruct, gpt-oss-120b
